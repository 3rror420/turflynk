}

.maplibregl-ctrl button{
  width:44px;
  height:44px;
  line-height:44px;
}

.maplibre-edit-handle{
  width:22px !important;
  height:22px !important;
  border-radius:999px;
  border:2px solid #ffffff;
  background:#3d6826;
