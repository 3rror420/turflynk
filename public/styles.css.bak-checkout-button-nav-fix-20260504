    background: linear-gradient(105deg, rgba(255, 255, 255, .94), rgba(255, 255, 255, .78));
  }

  .mownwa-hero-copy h2 {
    font-size: clamp(1.75rem, 9vw, 2.55rem);
  }

  .mownwa-hero-copy p {
    font-size: 1rem;
  }

  .mownwa-hero-cta {
    width: 100%;
    justify-content: center;
    min-height: 50px;
    font-size: .96rem;
    margin-top: 16px;
  }

  .mownwa-feature-strip {
    width: 100%;
    margin: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--mownwa-forest);
    border: 0;
    box-shadow: none;
  }

  .mownwa-feature {
    min-height: 110px;
    padding: 16px 12px;
    border-right: 1px solid rgba(255, 255, 255, .1);
