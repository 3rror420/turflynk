  }

  .mownwa-feature-icon {
    width: 26px;
    height: 26px;
    color: #b8dc84;
  }

  .mownwa-feature h3 {
    color: #ffffff;
    font-size: clamp(.78rem, 3vw, .92rem);
  }

  .mownwa-feature p {
    color: rgba(255, 255, 255, .72);
    font-size: .78rem;
    max-width: none;
    line-height: 1.35;
  }

  .mownwa-nwa-panel {
    min-height: 110px;
    padding: 0;
    background: #0b3d2e;
    grid-column: 1 / -1;
    border-right: 0;
  }

  .mownwa-feature:nth-child(3) {
    border-right: 0;
  }

  .service-area-card {
    padding: 16px 18px;
    gap: 10px;
  }

  .service-area-main {
    gap: 1rem;
  }

  .service-area-arkansas {
    width: clamp(96px, 30vw, 115px);
  }

  .service-area-title {
    font-size: clamp(1rem, 5.2vw, 1.45rem);
  }

  .service-area-kicker {
    font-size: .62rem;
  }

  .service-area-towns {
    display: block;
    margin-top: 2px;
    font-size: .78rem;
  }

  .mownwa-steps {
    padding: 44px 0 14px;
  }

  .mownwa-steps h2 {
    margin-bottom: 24px;
  }

  .mownwa-step-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .mownwa-step-card {
    min-height: 0;
    grid-template-columns: 42px 44px 1fr;
    justify-items: start;
    align-items: center;
    text-align: left;
    padding: 18px 18px 18px 14px;
    gap: 12px;
  }

  .mownwa-step-card:not(:last-child)::after {
    right: 24px;
    top: auto;
    bottom: -14px;
    width: 14px;
    height: 14px;
    transform: rotate(135deg);
  }

  .mownwa-step-number {
    position: static;
    transform: none;
    width: 34px;
    height: 34px;
    font-size: .95rem;
  }

  .mownwa-step-icon {
    width: 38px;
    height: 38px;
  }

  .mownwa-step-card h3,
  .mownwa-step-card p {
    grid-column: 3;
  }

  .mownwa-step-card h3 {
    font-size: 1rem;
    margin-bottom: -8px;
  }

  .mownwa-step-card p {
    font-size: .86rem;
    line-height: 1.4;
  }

  .mownwa-start-cta {
    padding: 10px 12px 36px;
  }

  .mownwa-start-btn {
    width: min(340px, 100%);
  }
