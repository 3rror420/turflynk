/* Mobile-first app polish */
html,body{
  width:100%;
  max-width:100%;
  overflow-x:hidden;
  -webkit-text-size-adjust:100%;
}

body{
  background:
    radial-gradient(circle at top left,rgba(74,124,47,.07),transparent 28rem),
    #1a1a1a;
}

.main-shell,.view,.section-grid,.panel,.card,.quote-panel,.side-explainer{
  min-width:0;
}

input,select,textarea,.btn,.nav-btn,.tab-btn{
  min-height:44px;
}

input,select,textarea{
  border-radius:14px;
  font-size:16px;
}

.btn,.nav-btn,.tab-btn{
  touch-action:manipulation;
}

.auth-bar{
  position:fixed;
  top:14px;
  right:14px;
  z-index:120;
  display:flex;
  align-items:center;
  gap:10px;
}

.mobile-brand{
  display:none;
  font-weight:900;
  letter-spacing:.01em;
}

.auth-panel{
  position:fixed;
  top:70px;
  right:14px;
  z-index:130;
  width:min(360px,calc(100vw - 28px));
  display:grid;
  gap:14px;
  padding:18px;
  border-radius:18px;
  border:1px solid var(--line);
  background:#1a1a1a;
  box-shadow:var(--shadow);
}

.auth-panel.hidden{
  display:none;
}

.auth-panel .tabs,.auth-tab{
  display:grid;
  gap:10px;
}

.facebook-login-link {
  display: flex;
  position: relative;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin: 10px 0;
  padding: 10px 14px;
  border-radius: 12px;
  background: #1877f2;
  color: #ffffff;
  font-weight: 800;
  text-decoration: none;
  pointer-events: auto;
  touch-action: manipulation;
  z-index: 1;
}

.facebook-login-link:hover,
.facebook-login-link:focus-visible {
  filter: brightness(1.04);
  transform: translateY(-1px);
}

.legal-page {
  max-width: 900px;
  margin: 40px auto;
  padding: 24px;
  color: #1f271c;
  background: #ffffff;
  border: 1px solid #dfe8dc;
  border-radius: 18px;
  box-shadow: 0 18px 46px rgba(31, 39, 28, .12);
}

.legal-page h1,
.legal-page h2 {
  color: #171717;
}

.legal-page a {
  color: #3d6826;
  font-weight: 800;
}

.legal-brand {
  margin: 0 0 8px;
  color: #3d6826;
  font-weight: 900;
  letter-spacing: 0;
}

.auth-status-page {
  text-align: center;
}

.auth-panel .tabs{
  grid-template-columns:1fr 1fr;
}

.auth-panel .tabs button,
.auth-panel form button{
  min-height:44px;
  border:1px solid var(--line);
  border-radius:14px;
  background:#2d2d2d;
  color:#e8e8e8;
  font-weight:800;
}

.auth-panel form button{
  background:#4a7c2f;
  color:#ffffff;
}

.auth-tab.hidden{
  display:none;
}

.contact-details{
