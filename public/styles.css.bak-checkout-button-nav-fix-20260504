  border-radius:16px;
  background:rgba(74,124,47,.07);
  padding:0;
  overflow:hidden;
}

.contact-details summary{
  min-height:48px;
  padding:14px 16px;
  cursor:pointer;
  font-weight:800;
  color:#f0f7eb;
}

.contact-details .grid-2,
.contact-details > label{
  padding:0 16px 16px;
}

.tool-row.major-tools{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(138px,1fr));
