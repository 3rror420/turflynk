// ── Tab switching ─────────────────────────────────────────────────────────────

function initAdminMgmtTabs() {
  const panel = byId('adminManagementPanel');
  if (!panel) return;

  panel.querySelectorAll('.admin-mgmt-tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      panel.querySelectorAll('.admin-mgmt-tab-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      panel.querySelectorAll('.admin-mgmt-tab').forEach((t) => { t.style.display = 'none'; });
      const tabEl = byId(`adminMgmt${target.charAt(0).toUpperCase() + target.slice(1)}`);
      if (tabEl) tabEl.style.display = '';
      if (target === 'jobs') loadAdminMgmtJobs().catch(() => {});
      if (target === 'users') loadAdminMgmtUsers().catch(() => {});
      if (target === 'providers') loadAdminMgmtProviders().catch(() => {});
    });
  });
}

// ── Helpers ───────────────────────────────────────────────────────────────────

function mgmtTable(headers, rows) {
  if (!rows.length) return '<div style="color:var(--muted);padding:12px">No records found.</div>';
  const th = headers.map((h) => `<th style="white-space:nowrap">${escapeHtml(h)}</th>`).join('');
  const body = rows.map((cells) => `<tr>${cells.map((c) => `<td>${c}</td>`).join('')}</tr>`).join('');
  return `<table class="admin-mgmt-tbl" style="width:100%;border-collapse:collapse;font-size:.85rem">
    <thead><tr style="text-align:left;border-bottom:1px solid var(--line)">${th}</tr></thead>
    <tbody>${body}</tbody>
  </table>`;
}

function payBadge(status) {
  const colors = { paid: '#4ade80', unpaid: '#f87171', deposit_paid: '#facc15', pending: '#94a3b8' };
  const c = colors[status] || '#94a3b8';
  return `<span style="background:${c}22;color:${c};padding:2px 8px;border-radius:6px;font-size:.8rem">${escapeHtml(status || 'unknown')}</span>`;
}

function activeBadge(active) {
  return active
    ? '<span style="background:#4ade8022;color:#4ade80;padding:2px 8px;border-radius:6px;font-size:.8rem">Active</span>'
    : '<span style="background:#f871712a;color:#f87171;padding:2px 8px;border-radius:6px;font-size:.8rem">Inactive</span>';
}

// ── Jobs Management ───────────────────────────────────────────────────────────

async function loadAdminMgmtJobs() {
  const wrap = byId('adminMgmtJobsTable');
  if (!wrap) return;
  wrap.innerHTML = '<div style="color:var(--muted);padding:12px">Loading...</div>';
  try {
    const data = await api('/api/admin/db-jobs');
    if (!data.jobs?.length) {
      wrap.innerHTML = '<div style="color:var(--muted);padding:12px">No DB jobs found.</div>';
      return;
    }

    const statusOptions = ['pending','assigned','completed','canceled','open','scheduled','in_progress','paid','payment_pending'];
    const paymentOptions = ['unpaid','deposit_paid','paid'];

    const rows = data.jobs.map((job) => {
      const addr = [job.address, job.city, job.state].filter(Boolean).join(', ');
      const statusSel = `<select class="mgmt-job-status" data-job-id="${escapeHtml(job.id)}" style="padding:4px 6px;font-size:.8rem;width:auto">
        ${statusOptions.map((s) => `<option value="${s}" ${job.status === s ? 'selected' : ''}>${s}</option>`).join('')}
      </select>`;
      const paymentSel = `<select class="mgmt-job-payment" data-job-id="${escapeHtml(job.id)}" style="padding:4px 6px;font-size:.8rem;width:auto">
        ${paymentOptions.map((p) => `<option value="${p}" ${job.payment_status === p ? 'selected' : ''}>${p}</option>`).join('')}
      </select>`;
      const deleteBtn = `<button class="btn secondary small mgmt-job-delete" data-job-id="${escapeHtml(job.id)}" type="button" style="color:#ef4444;border-color:#ef4444;padding:3px 8px;font-size:.8rem">Del</button>`;
      return [
        `<code style="font-size:.75rem">${escapeHtml(job.id)}</code>`,
        escapeHtml(job.customer_name || job.customer_email || '—'),
        escapeHtml(addr || '—'),
        statusSel,
        payBadge(job.payment_status),
        `$${Number(job.estimate_at_booking || 0).toFixed(2)}`,
        escapeHtml(job.created_at ? new Date(job.created_at).toLocaleDateString() : '—'),
        `${paymentSel} ${deleteBtn}`,
      ];
    });

    wrap.innerHTML = mgmtTable(
      ['Job ID','Customer','Address','Status','Payment','Amount','Created','Actions'],
      rows
    );

    // Wire status dropdowns
    wrap.querySelectorAll('.mgmt-job-status').forEach((sel) => {
      sel.addEventListener('change', async () => {
        const jobId = sel.dataset.jobId;
        try {
          await api(`/api/admin/jobs/${encodeURIComponent(jobId)}`, {
            method: 'PATCH',
            body: JSON.stringify({ status: sel.value }),
          });
          showToast(`Status → ${sel.value}`, 'success');
        } catch (err) {
          showError('Could not update status: ' + prettyApiError(err));
          loadAdminMgmtJobs().catch(() => {});
        }
      });
    });

    // Wire payment dropdowns
    wrap.querySelectorAll('.mgmt-job-payment').forEach((sel) => {
      sel.addEventListener('change', async () => {
        const jobId = sel.dataset.jobId;
        try {
          await api(`/api/admin/jobs/${encodeURIComponent(jobId)}`, {
            method: 'PATCH',
            body: JSON.stringify({ payment_status: sel.value }),
          });
          showToast(`Payment → ${sel.value}`, 'success');
        } catch (err) {
          showError('Could not update payment: ' + prettyApiError(err));
          loadAdminMgmtJobs().catch(() => {});
        }
      });
    });

    // Wire delete buttons
    wrap.querySelectorAll('.mgmt-job-delete').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const jobId = btn.dataset.jobId;
        if (!confirm(`Permanently delete job ${jobId}? This cannot be undone.`)) return;
        btn.disabled = true;
        try {
          await api(`/api/admin/jobs/${encodeURIComponent(jobId)}`, { method: 'DELETE' });
          showToast('Job deleted', 'success');
          await loadAdminMgmtJobs();
        } catch (err) {
          showError('Could not delete: ' + prettyApiError(err));
          btn.disabled = false;
        }
      });
    });
  } catch (err) {
    wrap.innerHTML = `<div style="color:var(--muted);padding:12px">Could not load jobs: ${escapeHtml(err.message)}</div>`;
  }
}

