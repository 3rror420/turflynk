<header class="app-topbar">
  <button class="app-brand-btn" type="button" data-jump-view="quote" aria-label="MowNWA home">
    <img src="/assets/brand/mownwa-logo-desktop.png" alt="MowNWA logo" class="app-brand-logo">
  </button>
  <span id="mobileViewTitle" class="topbar-view-chip"></span>
  <div class="app-topbar-actions">
    <button class="app-icon-btn" id="mobileAuthBtn" type="button" aria-label="Login or sign up" aria-haspopup="dialog">
      <span id="mobileAccountAvatar" class="account-avatar compact" aria-hidden="true">
        <img data-avatar-img alt="" hidden />
        <span data-avatar-initials>G</span>
      </span>
      <span id="mobileAuthLabel" class="mobile-auth-label">Login</span>
    </button>
    <button class="app-icon-btn" id="openAppDrawer" type="button" aria-label="Open menu" aria-controls="appDrawer" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>
