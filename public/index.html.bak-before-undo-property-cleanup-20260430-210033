<!-- Auth-gate modal: shown when a non-logged-in user tries to book a service -->
<div id="authGateModal" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="authGateTitle" style="display:none">
  <div class="modal-box">
    <h3 id="authGateTitle">Create account to book this service</h3>
    <p style="color:var(--muted);margin:0">Sign in or create a free account to book your lawn service and track job status.</p>
    <div class="tab-row">
      <button class="tab-btn active" id="gateLoginTab" type="button" onclick="showGateTab('login')">Login</button>
      <button class="tab-btn" id="gateRegisterTab" type="button" onclick="showGateTab('register')">Sign Up</button>
    </div>
    <form id="gateLoginForm" class="stack" style="gap:12px">
      <input name="email" type="email" placeholder="Email" autocomplete="email" required />
      <input name="password" type="password" placeholder="Password" autocomplete="current-password" required />
      <button class="btn primary" type="submit">Login &amp; Book</button>
    </form>
    <form id="gateRegisterForm" class="stack hidden" style="gap:12px">
      <input name="fullName" placeholder="Full Name" required />
      <input name="email" type="email" placeholder="Email" autocomplete="email" required />
      <input name="phone" type="tel" placeholder="Phone" autocomplete="tel" />
      <input name="password" type="password" placeholder="Password" autocomplete="new-password" required />
      <button class="btn primary" type="submit">Create Account &amp; Book</button>
    </form>
    <button class="btn ghost" type="button" id="closeAuthGateBtn" style="width:100%">Cancel</button>
  </div>
</div>

