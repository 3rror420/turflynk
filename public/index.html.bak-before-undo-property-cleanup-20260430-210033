  </div>

  <div id="authSignedInNotice">
    <p class="meta" style="margin:0 0 10px">You are signed in. Use the button below to switch accounts.</p>
    <button type="button" id="authPanelSignOutBtn" class="btn ghost" style="width:100%">Sign Out</button>
  </div>

  <div class="tabs">
    <button onclick="showAuthTab('login')">Login</button>
    <button onclick="showAuthTab('register')">Sign Up</button>
  </div>

